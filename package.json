{
  "name": "medical-learning-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable Medical Education, Universal Question Bank & Mock Exam Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/run_python.mjs dev.py",
    "dev:all": "bun scripts/run_python.mjs dev.py",
    "dev:web": "bun --filter web dev",
    "dev:backend": "bun scripts/run_python.mjs -m uvicorn backend.api.main:app --reload --port 8000",
    "dev:mobile": "bun --filter mobile start",
    "dev:mobile:web": "bun --filter mobile web",
    "dev:start": "concurrently -n \"DOCKER,BACKEND,FRONTEND\" -c \"blue,green,magenta\" \"bun run docker:up\" \"bun run dev:backend\" \"bun run dev:web\"",
    "build": "bun --filter \"*\" build",
    "typecheck": "bun --filter \"*\" typecheck",
    "lint": "bun --filter \"*\" lint",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f infrastructure/docker-compose.yml down -v && docker compose -f infrastructure/docker-compose.yml up -d",
    "db:init": "bun scripts/run_python.mjs -c \"from database.db import init_db; init_db(); print('✓ Database initialized successfully.')\"",
    "db:seed": "bun scripts/run_python.mjs scripts/seed_curriculum.py",
    "db:setup": "bun run db:init && bun run db:seed",
    "db:migrate": "bun scripts/run_python.mjs -m alembic upgrade head",
    "db:current": "bun scripts/run_python.mjs -m alembic current",
    "pipeline:run": "bun scripts/run_python.mjs scripts/run_pipeline.py",
    "ingest": "bun scripts/run_python.mjs scripts/ingest_cli.py",
    "docs:build": "bun scripts/run_python.mjs -m mkdocs build --strict",
    "docs:serve": "bun scripts/run_python.mjs -m mkdocs serve",
    "test:shared": "bun test packages/shared/src",
    "test:cms": "bun test tests-ts/cms_schema.test.ts",
    "test:editor": "bun test tests-ts/editor_schemas.test.ts",
    "ontology:preview": "bun scripts/run_python.mjs scripts/group_pathology_questions.py",
    "ontology:apply": "bun scripts/run_python.mjs scripts/group_pathology_questions.py --apply",
    "ontology:seed:surgical": "bun scripts/run_python.mjs scripts/seed_surgical_pathology_ontology.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.7.3"
  }
}

{
  "name": "medical-learning-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable Medical Education, Universal Question Bank & Mock Exam Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter web dev",
    "dev:web": "bun --filter web dev",
    "dev:mobile": "bun --filter student-native start",

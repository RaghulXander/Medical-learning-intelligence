# Google Cloud Platform & Document AI Configuration
# Based on project infrastructure defined in GCP.txt

# GCP Project ID
GCP_PROJECT_ID=doc-egde-rag

# GCP Region / Location (us, eu, etc.)
GCP_LOCATION=us

# GCP Document AI Layout Parser Processor ID
# Processor: docedge-layout-parser (Type: Layout Parser)
GCP_PROCESSOR_ID=a4fbeaa389c5955d

# Google Cloud Storage Buckets
# Raw document intake bucket for pilot and large PDF uploads
GCP_RAW_BUCKET=doc-egde-rag-rag-raw
# Output bucket for batch Document AI structured JSON artifacts
GCP_PROCESSED_BUCKET=doc-egde-rag-rag-processed

# Service Account & Authentication
# Service Account: docedge-ingestion@doc-egde-rag.iam.gserviceaccount.com
# Roles: roles/documentai.apiUser, roles/storage.objectViewer, roles/storage.objectUser
# Set to local path of service account JSON key file (or leave unset for Application Default Credentials / gcloud auth)
GOOGLE_APPLICATION_CREDENTIALS=

# Document AI Execution Limits & Policy:
# - Online processing (process_document): max 15 pages / 20MB per request, synchronous layout parsing
# - Batch processing (batch_process_documents): up to 500-1000 pages per request via GCS buckets, asynchronous
DOCAI_MAX_ONLINE_PAGES=15
DOCAI_MAX_ONLINE_SIZE_MB=20
DOCAI_TIMEOUT_SECONDS=120
DOCAI_MOCK_FALLBACK=true

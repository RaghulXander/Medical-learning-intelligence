# Values in EXPO_PUBLIC_* are embedded in the installed application and are not secrets.
EXPO_PUBLIC_API_URL=https://your-render-service.onrender.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-server-web-client-id.apps.googleusercontent.com

    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "1.37.0",
    "metro-runtime": "^0.81.0",
    "react": "19.1.0",

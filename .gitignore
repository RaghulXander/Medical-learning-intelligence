# External cloned repositories (e.g. MedMCQA original clone)
datasets/

# Large Raw Datasets & Reference PDFs (Immutable local files)
data/raw/medmcqa/*.parquet
data/raw/medmcqa/*.json
data/raw/medmcqa/*.jsonl
!data/raw/medmcqa/.gitkeep
data/raw/reference_documents/*.pdf
# Generated/extracted textbook artifacts are private and reproducible. This includes
# registries with local paths, slice manifests, OCR/layout JSON, evidence, and reports.
data/processed/reference_documents/**
!data/processed/reference_documents/.gitkeep

data/processed/images/*

# Large Processed Datasets (Reproduce via scripts/run_pipeline.py)
data/processed/pathology/*.jsonl
data/processed/pathology/*.parquet
data/processed/pathology/*.csv
!data/processed/pathology/.gitkeep
!data/processed/pathology/manifest.json
!data/processed/pathology/summary_report.json
!data/processed/pathology/VERSION

# Documentation Exceptions
!data/README.md

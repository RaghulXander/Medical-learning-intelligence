# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://medadmin:medsecret@localhost:5432/medical_exam_ai
POSTGRES_USER=medadmin
POSTGRES_PASSWORD=medsecret
POSTGRES_DB=medical_exam_ai
POSTGRES_PORT=5432

# Redis Queue Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Environment
NODE_ENV=development
APP_ENV=development
RELEASE_SHA=development

# Authentication (replace for every shared/staging/production environment)
JWT_SECRET_KEY=docedge_secret_jwt_key_development_only_2026_xander
GOOGLE_CLIENT_IDS=101917798792-febouigevelmm8of8c1eoqkn2hqnako8.apps.googleusercontent.com

# Browser origins allowed to call FastAPI directly (comma-separated, no wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
NEXT_PUBLIC_CONTACT_EMAIL=raghuljayan@gmail.com

# Next.js server-side API proxy target. In production use the public HTTPS API origin.
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Git-backed landing CMS (server-only; configure on Render, never NEXT_PUBLIC_*)
CMS_GITHUB_OWNER=RaghulXander
CMS_GITHUB_REPOSITORY=Medical-learning-intelligence
CMS_GITHUB_BRANCH=main
CMS_GITHUB_CONTENT_PATH=apps/web/content/landing-page.json
CMS_GITHUB_TOKEN=

# Future S3-compatible object storage (required before file uploads are enabled)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google Cloud Platform & Document AI (see .env.gcp.example for full details)
GCP_PROJECT_ID=doc-egde-rag
GCP_LOCATION=us
GCP_PROCESSOR_ID=a4fbeaa389c5955d
GCP_RAW_BUCKET=doc-egde-rag-rag-raw
GCP_PROCESSED_BUCKET=doc-egde-rag-rag-processed
GOOGLE_APPLICATION_CREDENTIALS=
DOCAI_MAX_ONLINE_PAGES=15
DOCAI_MOCK_FALLBACK=true
# Cloudflare R2 image-review proxy allowlist. Use the exact URL prefix before
# `/pathology/...` in image_assets.storage_uri; do not include a trailing slash.
R2_PUBLIC_URL=
